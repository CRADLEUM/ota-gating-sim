    given-names: Jerad
    affiliation: "University of Michigan-Flint"
  - family-names: Uludag
    given-names: Suleyman
    affiliation: "University of Michigan-Flint"
  - family-names: Bisgin
    given-names: Halil
    affiliation: "University of Michigan-Flint"

keywords:
  - over-the-air updates
  - autonomous vehicles
  - unmanned aerial vehicles
  - fleet management
  - monte carlo simulation

