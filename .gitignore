# gating_sim.py writes into its own directory. The reference copies live in
# expected/ and figures/, so the generated ones at the root stay untracked and
# a local run never shows up as a dirty working tree.
/results_v3.csv
/results_v4.csv
/sweeps_v4.csv
/replay_v4.csv
/run_v4.log
/run_v4.err
/crossover.png
/drivers.png
/sources.png

# verify.py runs in a temp dir by default; this covers --outdir used in-repo.
verify-run/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# The paper itself does not belong here.
*.tex
*.pdf
*.bib

# Editors and OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Raw pulls are large and some are license-restricted; only the manifest is tracked.
data/raw/*
!data/raw/manifest.json

# Per-window and per-trip derived CSVs are large (taxi: 270 MB). Step 3 replaces them
# with compact CDF and replay-sample files; until then only the summaries are tracked.
data/derived/**/*_windows.csv
data/derived/**/*_trace.csv
